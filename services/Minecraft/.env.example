# cp .env.example .env   and fill in. The real .env is git-ignored.

MC_VERSION=LATEST          # or a specific version like 1.21.10 to stop automatic version jumps
TZ=America/New_York
MOTD=Homelab Minecraft

# Comma-separated Minecraft usernames
WHITELIST=myname,friend1,friend2
OPS=myname

# Letters and numbers only. Generate with: openssl rand -hex 16
RCON_PASSWORD=change-me

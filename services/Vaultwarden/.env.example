# cp .env.example .env   and fill in. The real .env is git-ignored.

# Pinned to an exact release. Check https://github.com/dani-garcia/vaultwarden/releases before changing.
VAULTWARDEN_VERSION=1.37.4

# Tailscale name of the Apps VM, e.g. apps.tail1234.ts.net
TS_FQDN=apps.TAILNET.ts.net
TZ=America/New_York

# true only while creating your account, then set to false and run: docker compose up -d
SIGNUPS_ALLOWED=true

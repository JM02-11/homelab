# cp .env.example .env   and fill in. The real .env is git-ignored.

# Major version pin: gets patch releases, never jumps to a new major by itself.
NEXTCLOUD_VERSION=35

# Tailscale name of the Apps VM (shown by `tailscale status` / the admin console),
# e.g. apps.tail1234.ts.net
TS_FQDN=apps.TAILNET.ts.net

TZ=America/New_York

POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
# Letters and numbers only. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Only used on the very first start, to create the admin account
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me

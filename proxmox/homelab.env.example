# Settings for the Proxmox rebuild scripts.
# On the Proxmox host:  cp homelab.env.example homelab.env  and fill in the blanks.
# homelab.env is git-ignored.

NODE=pve                      # Proxmox node name (shown in the GUI tree)
VM_STORAGE=vmdata             # LVM-thin storage for VM disks (2 TB SATA SSD)
LAN_CIDR=192.168.1.0/24
GATEWAY=192.168.1.1
VM_DNS="1.1.1.1 9.9.9.9"      # DNS the VMs themselves use (not AdGuard, so the Apps VM can't break its own DNS)

# ---- DAS / ZFS pools ----
# One /dev/disk/by-id/ path per drive, space-separated (see REBUILD.md, phase 2)
# Data pool: the 3 x 960 GB SSDs (Nextcloud files)
POOL=das
POOL_LAYOUT=raidz1
POOL_DISKS=""
# Backup pool: the 2 x 1 TB WD hard drives (app backups + Proxmox VM backups)
BKP_POOL=bkp
BKP_LAYOUT=mirror
BKP_DISKS=""

# ---- VMs ----
# Ubuntu Server 26.04 LTS (Resolute Raccoon) cloud image
CLOUD_IMG_URL=https://cloud-images.ubuntu.com/resolute/current/resolute-server-cloudimg-amd64.img
VM_USER=homelab               # login user created by cloud-init (gets UID 1000)
SSH_PUBKEY_FILE=/root/homelab_ed25519.pub   # your PC's public key, copied to the host

APPS_VMID=100
APPS_NAME=apps
APPS_CORES=4
APPS_MEM=16384
APPS_DISK=120G
APPS_IP=192.168.1.61
APPS_MAC=""                   # filled from 01-teardown.sh output so the router reservation still matches

MC_VMID=101
MC_NAME=minecraft
MC_CORES=2
MC_MEM=6144
MC_DISK=40G
MC_IP=192.168.1.59
MC_MAC=""
